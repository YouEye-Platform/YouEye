# YouEye-UI Environment Variables
# Copy to .env.local for local development

# External URL (how users reach this app, including protocol)
UI_EXTERNAL_URL=https://yourdomain.com

# YouEye ID OAuth2 provider configuration
IDENTITY_URL=https://id.yourdomain.com
IDENTITY_INTERNAL_URL=http://10.x.x.x:3003
IDENTITY_CLIENT_ID=
IDENTITY_CLIENT_SECRET=

# JWT secret for session tokens (at least 32 characters)
JWT_SECRET=

# PostgreSQL connection string
DATABASE_URL=postgresql://yeui:PASSWORD@10.x.x.x:5432/yeui

# Set to "false" to disable Secure flag on cookies (for HTTP dev)
SECURE_COOKIES=true
