[Unit]
Description=YouEye console access (admins' host accounts)
Requires=youeye-appliance-state.service
After=youeye-appliance-state.service youeye-development-overlay.service network-online.target
Wants=network-online.target
Before=ssh.service getty@tty2.service serial-getty@ttyS0.service systemd-user-sessions.service
ConditionPathExists=/usr/lib/youeye/appliance-release

[Service]
Type=oneshot
ExecStart=/usr/local/bin/youeye console apply
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
