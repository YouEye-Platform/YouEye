[Unit]
Description=YouEye unsigned development overlay activator
Requires=youeye-appliance-state.service
After=youeye-appliance-state.service
Before=youeye-development-access.service youeye-console-status.service youeye-console-serial.service
ConditionPathExists=/usr/lib/youeye/appliance-release

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/youeye-apply-development-overlay boot
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
