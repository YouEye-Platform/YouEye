#!/bin/sh
set -eu

migrate_youeye_network_state() {
    network_file=$1
    [ -f "$network_file" ] || return 0
    grep -Fqx '[Network]' "$network_file" || return 0

    link_local=ipv4
    if grep -q '^Address=' "$network_file" && ! grep -q '^DHCP=ipv4$' "$network_file"; then
        link_local=no
    fi

    temp_file="${network_file}.youeye-ipv4.$$"
    trap 'rm -f "$temp_file"' EXIT HUP INT TERM

    sed \
        -e 's/^DHCP=yes$/DHCP=ipv4/' \
        -e 's/^IPv6AcceptRA=.*/IPv6AcceptRA=no/' \
        -e "s/^LinkLocalAddressing=.*/LinkLocalAddressing=$link_local/" \
        "$network_file" > "$temp_file"

    if ! grep -q '^IPv6AcceptRA=' "$temp_file"; then
        sed -i '/^\[Network\]$/a IPv6AcceptRA=no' "$temp_file"
    fi
    if ! grep -q '^LinkLocalAddressing=' "$temp_file"; then
        sed -i "/^\[Network\]$/a LinkLocalAddressing=$link_local" "$temp_file"
    fi

    chmod 0644 "$temp_file"
    if cmp -s "$network_file" "$temp_file"; then
        rm -f "$temp_file"
    else
        mv -f "$temp_file" "$network_file"
    fi
    trap - EXIT HUP INT TERM
}
