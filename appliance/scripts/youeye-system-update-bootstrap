#!/bin/sh
set -eu

# The Spine member artifact must sit at its exact source/tag/name location.
core_spine_url_valid() {
	case "$1" in
		"$2/releases/download/$3/$4") return 0 ;;
		*) return 1 ;;
	esac
}

# A promoted release may own the original bytes before the build tag is
# published. Only an actual 404 permits its exact hash-named mirror; the
# sha256 and size checks below apply to either delivery.
core_fetch_file() (
	fetch_url=$1; fetch_path=$2; fetch_limit=$3; fetch_mirror=${4:-}
	if fetch_status=$(curl --fail --silent --show-error --location --max-redirs 5 --max-time 180 \
		--proto '=https' --proto-redir '=https' --tlsv1.2 --max-filesize "$fetch_limit" \
		--write-out '%{http_code}' --output "$fetch_path" "$fetch_url"); then
		return 0
	fi
	[ "$fetch_status" = 404 ] && [ -n "$fetch_mirror" ] || return 1
	curl --fail --silent --show-error --location --max-redirs 5 --max-time 180 \
		--proto '=https' --proto-redir '=https' --tlsv1.2 --max-filesize "$fetch_limit" \
		--output "$fetch_path" "$fetch_mirror"
)

# The Core bridge retains the selected release's Spine outside both immutable
# host slots and hands the transition to it. Integrity: the exact
# core-release.json (fetched over HTTPS and required to match --sha256) binds
# the Spine artifact by sha256 and size. It never replaces the baked executable.
core_bootstrap() (
	[ "$(id -u)" = 0 ] || { printf 'Core bootstrap requires root.\n' >&2; exit 1; }
	[ "$#" -ge 1 ] || exit 2
	core_url=$1; shift
	inputs=; activate=false; expected_sha=
	while [ "$#" -gt 0 ]; do
		case "$1" in
			--inputs) [ "$#" -ge 2 ] || exit 2; inputs=$2; shift 2 ;;
			--sha256) [ "$#" -ge 2 ] || exit 2; expected_sha=$2; shift 2 ;;
			--activate) activate=true; shift ;;
			*) exit 2 ;;
		esac
	done
	case "$core_url" in
		https://*/releases/download/youeye-v*/core-release.json) ;;
		*) printf 'Core bootstrap requires an exact HTTPS core-release.json release URL.\n' >&2; exit 2 ;;
	esac
	case "$core_url" in *'?'*|*'#'*|*'%'*|*'@'*) exit 2 ;; esac
	# The document digest is the only binding for everything it lists.
	[ "${#expected_sha}" -eq 64 ] || { printf 'Core bootstrap requires --sha256 with the exact core-release.json digest.\n' >&2; exit 2; }
	case "$expected_sha" in *[!0-9a-f]*) exit 2 ;; esac
	umask 077
	work=$(mktemp -d /tmp/youeye-core-bootstrap.XXXXXX)
	stage=
	trap 'if [ -n "$stage" ]; then rm -f -- "$stage"; fi; rm -rf -- "$work"' EXIT
	protected() {
		test ! -L "$1" && test "$(stat -c %u "$1")" = 0 && test $((0$(stat -c %a "$1") & 0022)) = 0
	}
	if [ -n "$inputs" ]; then test -d "$inputs"; protected "$inputs"; fi
	fetch_input() {
		input_url=$1; input_name=$2; input_limit=$3; input_mirror=${4:-}
		if [ -n "$inputs" ]; then
			test -f "$inputs/$input_name"; protected "$inputs/$input_name"
			test "$(stat -c %s "$inputs/$input_name")" -le "$input_limit"
			cp -- "$inputs/$input_name" "$work/$input_name"
		else
			core_fetch_file "$input_url" "$work/$input_name" "$input_limit" "$input_mirror"
		fi
		test "$(stat -c %s "$work/$input_name")" -le "$input_limit"
	}
	fetch_input "$core_url" core-release.json 1048576
	manifest_sha=$(sha256sum "$work/core-release.json" | awk '{print $1}')
	if [ "$manifest_sha" != "$expected_sha" ]; then
		printf 'core-release.json checksum mismatch.\n' >&2
		exit 1
	fi
	jq -e '.schema == "youeye.core-release.v1" and .authority == "digest" and ([.members[] | select(.role == "spine")] | length == 1)' "$work/core-release.json" >/dev/null
	source=$(jq -er '.source' "$work/core-release.json")
	tag=$(jq -er '.tag' "$work/core-release.json")
	[ "$core_url" = "$source/releases/download/$tag/core-release.json" ]
	jq '.members[] | select(.role == "spine")' "$work/core-release.json" > "$work/member.json"
	jq -e '(.artifact.name | test("^[A-Za-z0-9][A-Za-z0-9._-]{0,199}$")) and (.artifact.sha256 | test("^[0-9a-f]{64}$")) and (.artifact.size_bytes > 0 and .artifact.size_bytes <= 134217728) and (.tag | test("^youeye-v[0-9]+\\.[0-9]+\\.[0-9]+(-[a-z][a-z0-9-]*\\.[1-9][0-9]*)?$"))' "$work/member.json" >/dev/null
	member_source=$(jq -er '.source' "$work/member.json")
	member_tag=$(jq -er '.tag' "$work/member.json")
	name=$(jq -er '.artifact.name' "$work/member.json")
	url=$(jq -er '.artifact.url' "$work/member.json")
	core_spine_url_valid "$url" "$member_source" "$member_tag" "$name"
	size=$(jq -er '.artifact.size_bytes' "$work/member.json")
	artifact_sha=$(jq -er '.artifact.sha256' "$work/member.json")
	fetch_input "$url" artifact "$size" "${core_url%/*}/blob-$artifact_sha"
	[ "$(stat -c %s "$work/artifact")" = "$size" ]
	[ "$(sha256sum "$work/artifact" | awk '{print $1}')" = "$artifact_sha" ] || {
		printf 'Spine artifact checksum mismatch.\n' >&2
		exit 1
	}
	root=/var/lib/youeye-state/core-update
	for directory in "$root" "$root/bootstrap" "$root/bootstrap/$artifact_sha"; do
		if [ ! -e "$directory" ]; then mkdir -m 0700 "$directory"; fi
		test -d "$directory"; protected "$directory"
	done
	binary=$root/bootstrap/$artifact_sha/youeye
	for field in artifact core-release.json; do
		file=$root/bootstrap/$artifact_sha/$field
		expected=$artifact_sha
		if [ "$field" = artifact ]; then file=$binary; else expected=$manifest_sha; fi
		if [ -e "$file" ]; then
			test -f "$file"; protected "$file"
			[ "$(sha256sum "$file" | awk '{print $1}')" = "$expected" ]
		else
			stage=$(mktemp "$root/bootstrap/$artifact_sha/.pending.XXXXXX")
			cp "$work/$field" "$stage"; chmod 0700 "$stage"; sync -f "$stage"
			ln "$stage" "$file"; rm "$stage"; stage=
			sync -f "$root/bootstrap/$artifact_sha"
		fi
	done
	# Same request is retained across interruption. Compatibility, machine
	# identity and paired recovery checks still run inside Spine.
	set -- update core bootstrap --request "stable-bootstrap-$manifest_sha" --manifest-sha256 "$manifest_sha"
	if [ "$activate" = true ]; then set -- "$@" --activate; fi
	"$binary" "$@"
)

if [ "${1:-}" = --core ]; then
	shift
	core_bootstrap "$@"
	exit $?
fi

printf 'Usage: %s --core <https .../releases/download/youeye-vX.Y.Z/core-release.json> --sha256 <core-release.json digest> [--inputs protected-directory] [--activate]\n' "$0" >&2
exit 2
