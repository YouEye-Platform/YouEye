    "clsx": "^2.1.1",
    "jose": "^6.1.3",
    "lucide-react": "^0.563.0",
    "next": "16.1.4",
    "next-intl": "^4.8.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
